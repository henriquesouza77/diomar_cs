# Copie para backend/.env (esse arquivo NÃO vai para o Git) e ajuste.
# Sem .env valem os padrões de desenvolvimento local e APP_DEBUG=false.

# Pasta do site na URL. Em domínio próprio (raiz), deixe vazio.
APP_BASE_PATH=/diomar-cs
APP_URL=http://localhost/diomar-cs

# true só em desenvolvimento: mostra detalhes de erro (nunca em produção)
APP_DEBUG=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=diomar_cs_imoveis
DB_USER=root
DB_PASS=

# Login com Google (https://console.cloud.google.com/apis/credentials).
# O redirect cadastrado lá deve ser: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
