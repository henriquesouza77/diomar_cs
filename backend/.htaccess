# ============================================================
# backend/.htaccess
# ============================================================

Options -Indexes

# Permite TUDO por padrão
Require all granted

# Bloqueia arquivos sensíveis (mas NÃO o api.php)
<FilesMatch "\.(env|log|sql|md|ini|conf|lock|bak)$">
    Require all denied
</FilesMatch>

# Bloqueia config.php e helpers.php (mas NÃO api.php)
<FilesMatch "^(config|helpers)\.php$">
    Require all denied
</FilesMatch>